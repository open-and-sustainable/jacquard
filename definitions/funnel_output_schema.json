{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jacquard funnel_output",
  "type": "object",
  "properties": {
    "jacquard_version": {
      "type": "string",
      "minLength": 1
    },
    "cutoffs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "anyOf": [
          {
            "maxItems": 0
          },
          {
            "minItems": 10,
            "maxItems": 10
          }
        ]
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "bucket": {
            "type": "string",
            "pattern": "^(missing|unparsed|zero|positive_decile_(0[1-9]|10))$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "stage",
          "field",
          "bucket",
          "count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "jacquard_version",
    "cutoffs",
    "cells"
  ],
  "additionalProperties": false,
  "definitions": {}
}
