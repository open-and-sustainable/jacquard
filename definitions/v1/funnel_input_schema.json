{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jacquard v1 funnel_input",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/definitions/metadata"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reference_values": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/measurement"
              }
            }
          },
          "passed_stages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "item_id",
          "values",
          "passed_stages"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "metadata",
    "stages",
    "reference_values",
    "items"
  ],
  "additionalProperties": false,
  "definitions": {
    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "parsed"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "missing",
                "unparsed"
              ]
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "v1"
        }
      },
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": false
    }
  }
}
